#Creat fasta file from all cleaned.fastq files and add the sample name at the begining of each sequence name
for f in *_cleaned.fastq; do
  sample="${f%_cleaned.fastq}"
  awk -v s="$sample" 'NR%4==1{h=$0; sub(/^@/,"",h); print ">"s"|"h} NR%4==2{print}' "$f"
done > all_samples.fasta

#Check orientationn and reverse complement if needed
Vsearch --db db/SILVA_1seqBYtax.fasta --fastaout all_samples.OK.fas --orient all_samples.fasta

#replace"|" by "_" in header
awk '/^>/{gsub(/\|/,"_")} {print}' all_samples.OK.fas > tmp && mv tmp all_samples.OK.fas

#filter out sequence < 1000nt
awk 'BEGIN{RS=">"; ORS=""; min=1000} NR>1{split($0,a,"\n"); h=a[1]; seq=""; for(i=2;i<=length(a);i++) if(a[i]!="") seq=seq a[i]; gsub(/[ \t\r\n]/,"",seq); if(length(seq)>=min) print ">"h"\n"seq"\n"}' all_samples.OK.fas > all_samples.min1000.fas

