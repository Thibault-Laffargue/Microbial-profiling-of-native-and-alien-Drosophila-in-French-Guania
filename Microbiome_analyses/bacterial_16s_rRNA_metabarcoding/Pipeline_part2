#creat taxonomy file
awk '
BEGIN{
  OFS="\t"
  split("kingdom phylum class order family genus species", R, " ")
}
/^>/{
  h = substr($0,2)

  id = h
  sub(/[ \t].*/,"",id)

  tax = h
  sub(/^[^ \t]+[ \t]+/,"",tax)
  if(tax == h) next

  n = split(tax, A, ";")

  out = ""
  k = 0
  for(i=1; i<=n; i++){
    t = A[i]
    gsub(/^[ \t]+|[ \t]+$/, "", t)     # trim
    if(t == "") continue

    # si le niveau est déjà "rank:taxon", on garde seulement la partie taxon
    if(index(t, ":") > 0){
      sub(/^[^:]*:/, "", t)
      gsub(/^[ \t]+|[ \t]+$/, "", t)
      if(t == "") continue
    }

    k++
    if(k > length(R)) break
    if(out != "") out = out ";"
    out = out R[k] ":" t
  }

  if(out != "") print id, out
}' db/SILVA_1seqBYtax.fasta > db/SILVA_1seqBYtax.BLCA.taxonomy




