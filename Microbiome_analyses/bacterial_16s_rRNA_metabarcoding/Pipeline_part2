#count the number of sequence contain in cluster of size < ou = 10 reads and count the number of sequence contain in cluster of size > 10
awk -F'\t' '
NR==1 {next}                # skip header
$1<=10 {le10 += $1*$2}      # sequences in clusters size <=10
$1>10  {gt10 += $1*$2}      # sequences in clusters size >10
